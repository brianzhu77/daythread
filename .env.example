# Daythread environment variables. Names only: never put a real value in git.
# Local: .env.local (ignored by git). Staging: Vercel env, scope "Preview". Production: Vercel env, scope "Production".
# Where to get each value: docs/ops/credentials.md

# Supabase project URL. Server-only: the browser never talks to Supabase (sign-in goes through our server).
SUPABASE_URL=
# Supabase publishable key. Server-only, used for the sign-in and sign-up calls.
SUPABASE_PUBLISHABLE_KEY=
# Supabase secret key (optional, server-only). With it, deleting an account deletes its Supabase login too.
SUPABASE_SECRET_KEY=
# Postgres connection string (secret). On Vercel, use the transaction pooler (port 6543).
DATABASE_URL=
# Who may sign up: `invite` (the default: addresses in the daythread.invites table or DAYTHREAD_INVITES) or `open`.
DAYTHREAD_SIGNUP=invite
# Invited addresses, comma-separated (optional; the invites table works without a redeploy).
DAYTHREAD_INVITES=
