# Daythread environment variables. Names only: never put a real value in git.
# Local: .env.local (ignored by git). Staging: Vercel env, scope "Preview". Production: Vercel env, scope "Production".
# Where to get each value: docs/ops/credentials.md

# Supabase project URL. Public: the server hands it to the browser for sign-in.
SUPABASE_URL=
# Supabase publishable key. Public: it can only sign in.
SUPABASE_PUBLISHABLE_KEY=
# Postgres connection string (secret). On Vercel, use the transaction pooler (port 6543).
DATABASE_URL=
# OpenRouter API key (secret). Without it, AI features run simulated.
OPENROUTER_API_KEY=
# OpenRouter model id. Unset = the default in src/server/model/openrouter.ts (DEFAULT_MODEL).
OPENROUTER_MODEL=
