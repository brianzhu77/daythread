# Placeholders only. Do not put real credentials in version control.
# None of these services are wired into the scaffold yet.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
DAYTHREAD_TIMEZONE=America/Vancouver

# Local SQLite (Node >=24); the original JSON source is imported once and kept unchanged.
DAYTHREAD_STORAGE=sqlite
DAYTHREAD_SQLITE_PATH=.daythread-local/workspace.sqlite
# Optional: set only when this existing JSON source should be imported. A missing explicit path is an error.
# DAYTHREAD_LOCAL_DATA_PATH=/absolute/path/to/workspace.json
# Set to debug for content-free JSON debug logs on both server and browser.
DAYTHREAD_LOG=
