# Daythread environment variables. Names only: never put a real value in this file or anywhere in git.
# Where each one lives is on the line above it:
#   local       = .env.local on the Mac (ignored by git)
#   staging     = Vercel project env, scope "Preview" (every PR deploy), pointed at the staging Supabase project
#   production  = Vercel project env, scope "Production" (enabled at the switch, not before)
#   CI          = GitHub Actions. CI needs none of these: it only typechecks, tests and builds.
# Full list with where to create each credential: docs/ops/credentials.md

# ---------------------------------------------------------------------------------------------------------------
# Today's app on the Mac (SQLite). Local only; on Vercel the SQLite store refuses to start.
# ---------------------------------------------------------------------------------------------------------------
# local: which store the server uses ("sqlite" today; "postgres" once the new core lands).
DAYTHREAD_STORAGE=sqlite
# local: the SQLite file (Node >= 24).
DAYTHREAD_SQLITE_PATH=.daythread-local/workspace.sqlite
# local, optional: a JSON source imported once into a new SQLite file. A missing explicit path is an error.
# DAYTHREAD_LOCAL_DATA_PATH=/absolute/path/to/workspace.json

# ---------------------------------------------------------------------------------------------------------------
# The new core (Supabase Postgres + sign-in). Read by the code from the direct build on; listed now so the
# accounts can be set up ahead.
# ---------------------------------------------------------------------------------------------------------------
# local + staging + production: the Supabase project URL (browser sign-in and the server's session check).
VITE_SUPABASE_URL=
# local + staging + production: the project's publishable key. Safe in the browser: it can only sign in, because the
# tables are not exposed to the Data API and only the server role writes.
VITE_SUPABASE_PUBLISHABLE_KEY=
# local + staging + production (secret): the server's runtime connection, as the restricted role that runs commands
# (no BYPASSRLS). On Vercel use the transaction pooler (port 6543).
DATABASE_URL=
# local only (secret): the privileged connection used by migrations (direct or session pooler, port 5432).
# Never set on Vercel.
DATABASE_MIGRATION_URL=
# local + staging + production: the only email allowed to sign in.
DAYTHREAD_OWNER_EMAIL=

# ---------------------------------------------------------------------------------------------------------------
# The model (OpenRouter). Use a separate key with its own spending limit for staging.
# ---------------------------------------------------------------------------------------------------------------
# local + staging + production (secret).
OPENROUTER_API_KEY=
# local + staging + production: the model id.
OPENROUTER_MODEL=
# optional: override the API base URL.
# OPENROUTER_BASE_URL=
# optional: "confirm" makes captures wait for confirmation; default "auto".
# DAYTHREAD_CAPTURE_MODE=
# optional: "simulated" keeps Draft my day simulated even with a key.
# DAYTHREAD_DRAFT=

# ---------------------------------------------------------------------------------------------------------------
# Vercel
# ---------------------------------------------------------------------------------------------------------------
# staging + production (secret): authenticates Vercel Cron calls to the job-recovery endpoint (once it exists).
CRON_SECRET=
# local, for scripts/smoke-staging.mjs (secret): Vercel's "Protection Bypass for Automation" secret, so the smoke check
# can reach a protected preview deploy. Not needed by the app.
VERCEL_AUTOMATION_BYPASS_SECRET=
# local, optional: "vercel" builds the Vercel output locally (Vercel itself sets VERCEL=1).
# DAYTHREAD_TARGET=vercel

# ---------------------------------------------------------------------------------------------------------------
# Development only
# ---------------------------------------------------------------------------------------------------------------
# local: "debug" for content-free JSON debug logs on server and browser.
DAYTHREAD_LOG=
# local: "1" shows the developer banner (simulated AI outcome switch, sample data in dev). Off in normal builds.
VITE_DEV_MENU=
# local, optional: custom text for that banner.
# VITE_TRIAL_BANNER=
