GOTRUE_JWT_SECRET=rig-only-jwt-secret-at-least-32-characters-long
GOTRUE_JWT_EXP=3600
GOTRUE_JWT_AUD=authenticated
GOTRUE_JWT_DEFAULT_GROUP_NAME=authenticated
GOTRUE_JWT_ADMIN_ROLES=supabase_admin,service_role
GOTRUE_DB_DRIVER=postgres
DB_NAMESPACE=auth
DATABASE_URL=postgres://supabase_auth_admin:root@127.0.0.1:54888/postgres?sslmode=disable
API_EXTERNAL_URL=http://127.0.0.1:54321/auth/v1
GOTRUE_API_HOST=127.0.0.1
PORT=9999
GOTRUE_SITE_URL=http://127.0.0.1:3580
GOTRUE_SMTP_HOST=127.0.0.1
GOTRUE_SMTP_PORT=2525
GOTRUE_SMTP_USER=rig
GOTRUE_SMTP_PASS=rig
GOTRUE_SMTP_ADMIN_EMAIL=no-reply@rig.local
GOTRUE_SMTP_SENDER_NAME=Daythread
GOTRUE_SMTP_MAX_FREQUENCY=10s
GOTRUE_MAILER_AUTOCONFIRM=false
GOTRUE_MAILER_OTP_EXP=30
GOTRUE_MAILER_URLPATHS_CONFIRMATION=/verify
GOTRUE_MAILER_URLPATHS_RECOVERY=/verify
GOTRUE_DISABLE_SIGNUP=false
GOTRUE_EXTERNAL_EMAIL_ENABLED=true
GOTRUE_RATE_LIMIT_EMAIL_SENT=1000
GOTRUE_LOG_LEVEL=info
